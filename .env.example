# Sao chép thành `.env` và điền giá trị (không commit `.env`).
# Lấy URL + anon key trong Supabase: Project Settings → API.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Script `npm run push-catalog` (Node, không qua Vite):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...   (khuyến nghị: bỏ qua RLS khi import)
# hoặc dùng SUPABASE_ANON_KEY nếu đã bật policy mở như migration mẫu.
